{
  "name": "tongzhou",
  "version": "0.5.7",
  "description": "同舟 — 多模型协作，一个工作台。An open-source, local-first agent workspace.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Tongzhou contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/icon.mjs && tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "test:extensions": "node scripts/extensions-smoke.mjs",
    "test:bridge": "node scripts/bridge-smoke.mjs",
    "test:workflows": "node scripts/workflows-smoke.mjs",
    "test:turns": "node scripts/turn-process-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:workbench": "node scripts/workbench-smoke.mjs",
    "test:markdown": "node scripts/markdown-smoke.mjs",
    "test:appearance": "node scripts/appearance-smoke.mjs",
    "test:attachments": "node scripts/attachments-smoke.mjs",
    "test:auth": "node scripts/account-ui-smoke.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "test:capabilities": "node scripts/capabilities-smoke.mjs",
    "test:management": "node scripts/client-management-smoke.mjs",
    "test:computer": "node scripts/computer-smoke.mjs",
    "test:live": "node scripts/live-coding-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:latency": "node scripts/chat-latency-smoke.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@minimax-ai/code": "0.4.12",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@moonshot-ai/kimi-code": "2.1.1",
    "@openai/codex": "0.160.0",
    "@vscode/ripgrep": "1.18.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.6-beta.1",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "lucide-react": "^0.468.0",
    "mermaid": "12.1.0",
    "node": "22.23.3",
    "nodemailer": "10.0.13",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "org.tongzhou.desktop",
    "productName": "Tongzhou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "NOTICE",
      "build/node-LICENSE.txt",
      "build/computer/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*",
      "build/computer/**/*",
      "dist-electron/tool-proxy.cjs",
      "dist-electron/builtin-mcp.cjs"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "同舟需要在你批准后聚焦指定窗口并完成电脑操作。"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "npmRebuild": false
  }
}
