{
  "name": "tongzhou",
  "version": "1.0.0",
  "description": "同舟 — 多模型协作，一个工作台。An open-source, local-first agent workspace.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Tongzhou contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/icon.mjs && tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "node scripts/testing/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "test:extensions": "node scripts/testing/extensions-smoke.mjs",
    "test:dynamic-tools": "node scripts/testing/dynamic-tools-smoke.mjs",
    "test:workflows": "node scripts/testing/workflows-smoke.mjs",
    "test:turns": "node scripts/testing/turn-process-smoke.mjs",
    "test:message-resend": "node scripts/testing/message-resend-smoke.mjs",
    "test:permissions": "node scripts/testing/live-permission-smoke.mjs",
    "test:ui": "node scripts/testing/ui-smoke.mjs",
    "test:session-entry": "node scripts/testing/session-entry-smoke.mjs",
    "test:workbench": "node scripts/testing/workbench-smoke.mjs",
    "test:local-github": "node scripts/testing/local-github-smoke.mjs",
    "test:local-gitlab": "node scripts/testing/local-github-smoke.mjs",
    "test:workspace-layout": "node scripts/testing/workspace-layout-smoke.mjs",
    "test:markdown": "node scripts/testing/markdown-smoke.mjs",
    "test:appearance": "node scripts/testing/appearance-smoke.mjs",
    "test:attachments": "node scripts/testing/attachments-smoke.mjs",
    "test:project-context": "node scripts/testing/project-context-smoke.mjs",
    "test:auth": "node scripts/testing/account-ui-smoke.mjs",
    "test:account-proxy": "node scripts/testing/account-proxy-smoke.mjs",
    "test:managed-network": "node scripts/testing/managed-network-smoke.mjs",
    "test:native": "node scripts/testing/native-smoke.mjs",
    "test:capabilities": "node scripts/testing/capabilities-smoke.mjs",
    "test:management": "node scripts/testing/client-management-smoke.mjs",
    "test:computer": "node scripts/testing/computer-smoke.mjs",
    "test:mac-permissions": "node scripts/testing/macos-permissions-smoke.mjs",
    "test:live": "node scripts/testing/live-coding-smoke.mjs",
    "test:package": "node scripts/testing/package-smoke.mjs",
    "test:latency": "node scripts/testing/chat-latency-smoke.mjs",
    "test:task-workbench": "node scripts/testing/task-workbench-smoke.mjs",
    "test:knowledge": "node scripts/testing/knowledge-smoke.mjs",
    "test:personalization": "node scripts/testing/personalization-smoke.mjs",
    "test:content": "node scripts/testing/content-workspace-smoke.mjs",
    "test:automations": "node scripts/testing/automation-smoke.mjs",
    "test:regression": "node scripts/testing/regression.mjs",
    "test:model-core": "node scripts/testing/model-gateway-smoke.mjs --auto-compact"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@minimax-ai/code": "0.4.12",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@moonshot-ai/kimi-code": "2.1.1",
    "@openai/codex": "0.160.0",
    "@vscode/ripgrep": "1.18.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "cordis": "4.0.0-rc.10",
    "diff": "9.0.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "dompurify": "3.4.16",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "lucide-react": "^0.468.0",
    "mermaid": "12.1.0",
    "node": "22.23.3",
    "node-pty": "1.1.0",
    "nodemailer": "10.0.13",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "OrenZhang",
        "repo": "tongzhou",
        "releaseType": "release"
      }
    ],
    "appId": "org.tongzhou.desktop",
    "productName": "Tongzhou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon-mac.png",
      "package.json",
      "LICENSE",
      "NOTICE",
      "docs/MIHOMO-LICENSE.txt",
      "build/node-LICENSE.txt",
      "build/computer/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*",
      "build/computer/**/*",
      "dist-electron/node-request-identity.cjs",
      "dist-electron/network-core-host.cjs",
      "dist-electron/builtin-mcp.cjs",
      "dist-electron/terminal-host.cjs"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "同舟",
      "uninstallDisplayName": "同舟 ${version}",
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleDisplayName": "同舟",
        "NSAppleEventsUsageDescription": "同舟需要在你批准后聚焦指定窗口并完成电脑操作。"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Tongzhou contributors <84196323+OrenZhang@users.noreply.github.com>",
      "category": "Development"
    },
    "npmRebuild": false
  }
}
