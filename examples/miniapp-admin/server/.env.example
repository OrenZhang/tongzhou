# 服务监听端口
PORT=3000
# 服务监听地址：默认仅本机回环地址；对外部署时显式设置为 0.0.0.0 并配合 HTTPS 反向代理
HOST=127.0.0.1
# SQLite 数据库文件路径（相对 server 目录或绝对路径）
DB_PATH=./data/app.db
# 首次初始化账号密码：生产模式（NODE_ENV=production）必须显式设置，
# 否则不会创建任何账号与演示数据；开发环境缺省时使用内置演示密码
ADMIN_PASSWORD=
OPERATOR_PASSWORD=
# 会话有效期（小时）
SESSION_HOURS=12
# 安全 Cookie：生产模式必须置 1（要求 HTTPS 部署），否则服务拒绝启动；本地开发保持 0
SECURE_COOKIE=0
